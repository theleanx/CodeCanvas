ANTHROPIC_API_KEY=sk-ant-...
CODECANVAS_AGENT_MODEL=claude-sonnet-5

# Optional -- only needed if you want the "Push to GitHub" button on the
# FSD Review page to work. A Personal Access Token with "Contents: write"
# on the target repo: https://github.com/settings/tokens
GITHUB_EXPORT_TOKEN=
GITHUB_EXPORT_REPO=owner/repo
GITHUB_EXPORT_BASE_PATH=fsd-exports

# Optional -- only needed for the "Push to Google Drive" button. A service
# account key's full JSON (one line), from a project with the Drive API
# enabled. Share the destination Drive folder with the service account's
# client_email as an Editor, then put that folder's id here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
